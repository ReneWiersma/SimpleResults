<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Simple Result</Title>
    <Description>A simple, immutable Result type for C# that encapsulates either a success value or an error. Features implicit conversions, nullability-aware IsSuccess/IsFailure checks, and static factory methods — no dependencies, no boilerplate.</Description>
	<PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <PackageTags>result;result-type;either;error-handling;success;failure;implicit-conversion;nullability;no-dependencies</PackageTags>
    <PackageReleaseNotes>A simple, immutable Result type for C# that encapsulates either a success value or an error.</PackageReleaseNotes>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <Version>1.1.1</Version>
    <PackageProjectUrl>https://github.com/ReneWiersma/SimpleResults</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\License.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.MD">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
